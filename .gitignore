# =============================================================================
# DocIQ monorepo — root .gitignore
# =============================================================================

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.springBeans
.sts4-cache
.apt_generated

# ── Agent / local assistants ─────────────────────────────────────────────────
.claude/

# ── Secrets / local env (NEVER commit) ───────────────────────────────────────
.env
.env.*
!.env.example

# ── Java / Maven (backend) ───────────────────────────────────────────────────
dociq-backend/target/
dociq-backend/.mvn/wrapper/maven-wrapper.jar
dociq-backend/HELP.md
dociq-backend/uploads/
*.class
*.jar
*.war
*.ear

# ── Node / Next.js (frontend) ────────────────────────────────────────────────
dociq-frontend/node_modules/
dociq-frontend/.next/
dociq-frontend/out/
dociq-frontend/build/
dociq-frontend/dist/
dociq-frontend/*.tsbuildinfo
dociq-frontend/.turbo/
dociq-frontend/.vercel/

# ── Logs / runtime ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build / tooling ──────────────────────────────────────────────────────────
out/
build/
dist/
coverage/
.nyc_output/

# ── Local scratch ────────────────────────────────────────────────────────────
tmp/
temp/
*.swp
*.bak

# ── Personal / private (local only, never commit) ────────────────────────────
docs/
My_thought.md
dociq-mermaid-diagrams.md
impo.txt
